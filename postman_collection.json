    {
      "name": "Assessments",
      "item": [
        {
          "name": "Get Assessments",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/assessments",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "assessments"]
            },
            "description": "Retrieve all assessments for the authenticated user. Returns a list of assessment summaries."
          },
          "response": []
        },
        {
          "name": "Generate Assessment",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Save assessment ID for later use",
                  "if (pm.response.code === 201) {",
                  "    const jsonData = pm.response.json();",
                  "    if (jsonData.data && jsonData.data.assessmentId) {",
                  "        pm.collectionVariables.set('assessmentId', jsonData.data.assessmentId);",
                  "        console.log('Assessment ID saved:', jsonData.data.assessmentId);",
                  "    }",
                  "}",
                  "",
                  "// Test response structure",
                  "pm.test('Status code is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Response has success field', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('success');",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "});",
                  "",
                  "pm.test('Response contains assessment data', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data).to.have.property('assessmentId');",
                  "    pm.expect(jsonData.data).to.have.property('possibleCondition');",
                  "    pm.expect(jsonData.data).to.have.property('nextSteps');",
                  "    pm.expect(jsonData.data).to.have.property('providers');",
                  "    pm.expect(jsonData.data).to.have.property('products');",
                  "});",
                  "",
                  "pm.test('Possible condition has required fields', function () {",
                  "    const jsonData = pm.response.json();",
                  "    const condition = jsonData.data.possibleCondition;",
                  "    pm.expect(condition).to.have.property('name');",
                  "    pm.expect(condition).to.have.property('description');",
                  "    pm.expect(condition).to.have.property('commonTriggers');",
                  "    pm.expect(condition).to.have.property('initialSelfCare');",
                  "});",
                  "",
                  "pm.test('Next steps is an array', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data.nextSteps).to.be.an('array');",
                  "    pm.expect(jsonData.data.nextSteps.length).to.be.at.least(3);",
                  "    pm.expect(jsonData.data.nextSteps.length).to.be.at.most(5);",
                  "});",
                  "",
                  "pm.test('Providers array has valid structure', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data.providers).to.be.an('array');",
                  "    if (jsonData.data.providers.length > 0) {",
                  "        const provider = jsonData.data.providers[0];",
                  "        pm.expect(provider).to.have.property('name');",
                  "        pm.expect(provider).to.have.property('specialty');",
                  "        pm.expect(provider).to.have.property('distance');",
                  "        pm.expect(provider).to.have.property('rating');",
                  "    }",
                  "});",
                  "",
                  "pm.test('Products array has valid structure', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data.products).to.be.an('array');",
                  "    if (jsonData.data.products.length > 0) {",
                  "        const product = jsonData.data.products[0];",
                  "        pm.expect(product).to.have.property('name');",
                  "        pm.expect(product).to.have.property('type');",
                  "        pm.expect(product).to.have.property('isPrescription');",
                  "    }",
                  "});",
                  "",
                  "pm.test('Confidence score is valid', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data.confidence).to.be.a('number');",
                  "    pm.expect(jsonData.data.confidence).to.be.at.least(0);",
                  "    pm.expect(jsonData.data.confidence).to.be.at.most(1);",
                  "});",
                  "",
                  "pm.test('Execution time is recorded', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data.executionTimeMs).to.be.a('number');",
                  "    pm.expect(jsonData.data.executionTimeMs).to.be.above(0);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"conversationId\": \"{{conversationId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/assessments/generate",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "assessments", "generate"]
            },
            "description": "Generate a comprehensive AI-powered health assessment from a conversation history.\n\n**Requirements:**\n- Conversation must have at least 2 user messages\n- User must have location data in profile for provider recommendations\n\n**Processing Time:** 10-15 seconds\n\n**Response includes:**\n- Extracted symptoms with severity and details\n- Possible condition diagnosis with confidence score\n- Up to 10 nearby healthcare provider recommendations\n- Up to 8 product/medication suggestions\n- 3-5 actionable next steps\n- Medical disclaimer\n\n**Note:** Before running this request, make sure to:\n1. Send at least 2 messages in a conversation (use Chat → Send Message)\n2. Save the conversation ID to the {{conversationId}} variable\n3. Ensure your user profile has location data"
          },
          "response": [
