    {
      "name": "Chat",
      "item": [
        {
          "name": "Start New Conversation",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Auto-save conversation ID for future messages",
                  "if (pm.response.code === 201) {",
                  "    const jsonData = pm.response.json();",
                  "    if (jsonData.data && jsonData.data.conversation && jsonData.data.conversation.id) {",
                  "        pm.collectionVariables.set('conversationId', jsonData.data.conversation.id);",
                  "        console.log('Conversation ID saved:', jsonData.data.conversation.id);",
                  "    }",
                  "}",
                  "",
                  "pm.test('Status code is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Response has conversation and message', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "    pm.expect(jsonData.data).to.have.property('conversation');",
                  "    pm.expect(jsonData.data).to.have.property('message');",
                  "    pm.expect(jsonData.data.message.role).to.equal('assistant');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"I have been having frequent headaches lately\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/chat/conversations/start",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "chat", "conversations", "start"]
            },
            "description": "Start a new conversation with your first message. The AI will respond and the conversation ID will be automatically saved.\n\n**Response includes:**\n- New conversation details (id, title, createdAt)\n- AI assistant's response message\n\n**Next steps:**\n- Use 'Continue Conversation' to add more messages\n- After 2-3 detailed messages, generate an assessment"
          },
          "response": []
        },
        {
          "name": "Continue Conversation",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response has AI message', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "    pm.expect(jsonData.data).to.have.property('message');",
                  "    pm.expect(jsonData.data.message.role).to.equal('assistant');",
                  "    pm.expect(jsonData.data.message.content).to.be.a('string');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"The pain is usually on the right side of my head and it's throbbing. It lasts for several hours and happens 2-3 times per week.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/chat/conversations/{{conversationId}}/messages",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "chat", "conversations", "{{conversationId}}", "messages"]
            },
            "description": "Add a message to an existing conversation. The AI will respond with full context of previous messages.\n\n**Features:**\n- AI remembers all previous messages\n- Asks relevant follow-up questions\n- Detects emergency symptoms automatically\n\n**Tips:**\n- Be specific about symptoms (location, duration, severity)\n- Mention triggers or patterns\n- Answer AI's follow-up questions"
          },
          "response": []
        },
        {
          "name": "List Conversations",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response has conversations array', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "    pm.expect(jsonData.data.conversations).to.be.an('array');",
                  "    pm.expect(jsonData.data).to.have.property('pagination');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/chat/conversations?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "chat", "conversations"],
              "query": [
                {
                  "key": "page",
                  "value": "1",
                  "description": "Page number (default: 1)"
                },
                {
                  "key": "limit",
                  "value": "20",
                  "description": "Items per page (default: 20, max: 100)"
                }
              ]
            },
            "description": "Get all conversations for the authenticated user. Perfect for displaying in a sidebar.\n\n**Response includes:**\n- Array of conversations (id, title, status, lastMessageAt)\n- Pagination info (total, page, limit, totalPages)\n\n**Sorted by:** Most recent first (lastMessageAt DESC)"
          },
          "response": []
        },
        {
          "name": "Get Conversation with Messages",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response has conversation and messages', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "    pm.expect(jsonData.data).to.have.property('conversation');",
                  "    pm.expect(jsonData.data).to.have.property('messages');",
                  "    pm.expect(jsonData.data).to.have.property('messageCount');",
                  "    pm.expect(jsonData.data.messages).to.be.an('array');",
                  "});",
                  "",
                  "pm.test('Message count has required fields', function () {",
                  "    const jsonData = pm.response.json();",
                  "    const count = jsonData.data.messageCount;",
                  "    pm.expect(count).to.have.property('total');",
                  "    pm.expect(count).to.have.property('current');",
                  "    pm.expect(count).to.have.property('page');",
                  "    pm.expect(count).to.have.property('limit');",
                  "    pm.expect(count).to.have.property('totalPages');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/chat/conversations/{{conversationId}}?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "chat", "conversations", "{{conversationId}}"],
              "query": [
                {
                  "key": "page",
                  "value": "1",
                  "description": "Page number (default: 1)"
                },
                {
                  "key": "limit",
                  "value": "10",
                  "description": "Messages per page (default: 10, max: 100)"
                }
              ]
            },
            "description": "Get a single conversation with its messages (paginated).\n\n**Response includes:**\n- Conversation details (id, title, status, timestamps)\n- Array of messages (id, role, content, createdAt)\n- Message count info:\n  - total: Total messages in conversation\n  - current: Messages in current page\n  - page: Current page number\n  - limit: Messages per page\n  - totalPages: Total pages available\n\n**Use for:** Loading conversation history in chat UI"
          },
          "response": []
        },
